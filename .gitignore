4. Admin client logic — paste into bootAdmin() in CLIENT_JS

Find the line if (name === 'settings') fillSettings(); in the tabs handler and replace it with:

```js
        if (name === 'settings') fillSettings();
        if (name === 'social') loadSocial();
```

Then, inside bootAdmin(), paste this block anywhere after loadStores is defined (e.g. right before function fillSettings(){):

```js
    /* ---- Social Media tab ---- */
    var SOCIAL_PLATFORMS_CACHE = null;

    function loadPlatforms() {
      if (SOCIAL_PLATFORMS_CACHE) return Promise.resolve(SOCIAL_PLATFORMS_CACHE);
      return TED.get('/api/social/platforms').then(function (res) {
        SOCIAL_PLATFORMS_CACHE = res.platforms;
        return res.platforms;
      });
    }

    function loadSocial() {
      var el = document.getElementById('socialAccountsList');
      el.innerHTML = '<div class="muted small">Loading...</div>';
      Promise.all([
        loadPlatforms(),
        TED.get('/api/stores/' + state.store.id + '/social')
      ]).then(function (results) {
        var platforms = results[0], accounts = results[1].accounts;
        if (!accounts.length) {
          el.innerHTML = '<div class="empty" style="padding:32px;">No social accounts connected yet. ' +
            'Click "+ Connect platform" to link one.</div>';
          return;
        }
        el.innerHTML = '<div class="table-wrap"><table><thead><tr>' +
          '<th>Platform</th><th>Handle</th><th>URL</th><th>Status</th><th></th>' +
          '</tr></thead><tbody>' +
          accounts.map(function (a) {
            var p = platforms[a.platform] || { label: a.platform, icon: '?', color: '#666' };
            var badge = a.verified
              ? '<span class="badge ok">✓ verified</span>'
              : '<span class="badge draft">unverified</span>';
            return '<tr>' +
              '<td><span style="display:inline-grid;place-items:center;width:28px;height:28px;' +
                'border-radius:8px;background:' + TED.esc(p.color) + ';color:#fff;font-weight:800;' +
                'font-size:13px;margin-right:8px;">' + TED.esc(p.icon) + '</span>' +
                '<strong>' + TED.esc(p.label) + '</strong></td>' +
              '<td>@' + TED.esc(a.handle) + '</td>' +
              '<td class="small"><a href="' + TED.esc(a.profile_url) + '" target="_blank" rel="noopener">' +
                TED.esc(a.profile_url.replace(/^https?:\/\//, '').slice(0, 40)) + '</a></td>' +
              '<td>' + badge + '</td>' +
              '<td style="text-align:right;white-space:nowrap;">' +
                (a.verified ? '' : '<button class="btn ghost sm" data-verify-social="' + a.id + '">Verify</button> ') +
                '<button class="btn ghost sm" data-edit-social="' + a.id + '">Edit</button> ' +
                '<button class="btn danger sm" data-del-social="' + a.id + '">Disconnect</button>' +
              '</td></tr>';
          }).join('') + '</tbody></table></div>';
      }).catch(function (err) {
        el.innerHTML = '<div class="muted">' + TED.esc(err.message) + '</div>';
      });
    }

    function openConnectSocialModal() {
      loadPlatforms().then(function (platforms) {
        var opts = Object.keys(platforms).map(function (k) {
          return '<option value="' + k + '">' + TED.esc(platforms[k].label) + '</option>';
        }).join('');
        modalRoot.innerHTML = '<div class="modal-backdrop" data-close><div class="modal">' +
          '<h2>Connect a social platform</h2>' +
          '<p class="muted small" style="margin-top:-10px;">Enter the handle you use on that platform.</p>' +
          '<form id="socialForm">' +
            '<div class="field"><label>Platform</label><select name="platform">' + opts + '</select></div>' +
            '<div class="field"><label>Handle (without @)</label>' +
              '<input name="handle" required placeholder="yourhandle"></div>' +
            '<div class="field"><label>Profile URL (optional — auto-generated if blank)</label>' +
              '<input name="profile_url" placeholder="https://..."></div>' +
            '<div class="modal-actions"><button type="button" class="btn ghost" data-cancel>Cancel</button>' +
              '<button type="submit" class="btn">Connect</button></div></form></div></div>';
        modalRoot.querySelector('[data-close]').onclick = function (e) { if (e.target === e.currentTarget) modalRoot.innerHTML = ''; };
        modalRoot.querySelector('[data-cancel]').onclick = function () { modalRoot.innerHTML = ''; };
        modalRoot.querySelector('#socialForm').onsubmit = function (e) {
          e.preventDefault();
          var fd = new FormData(e.target);
          TED.post('/api/stores/' + state.store.id + '/social', {
            platform: fd.get('platform'),
            handle: fd.get('handle'),
            profile_url: fd.get('profile_url')
          }).then(function () {
            modalRoot.innerHTML = '';
            TED.toast('Platform connected', 'success');
            loadSocial();
          }).catch(function (err) { TED.toast(err.message, 'error'); });
        };
      });
    }

    function openVerifyModal(accountId) {
      TED.post('/api/stores/' + state.store.id + '/social/' + accountId + '/verify/request')
        .then(function (res) {
          modalRoot.innerHTML = '<div class="modal-backdrop" data-close><div class="modal">' +
            '<h2>Verify your ' + TED.esc(res.platform) + '</h2>' +
            '<p class="muted" style="margin-top:-10px;">' + TED.esc(res.instructions) + '</p>' +
            '<div class="card" style="text-align:center;background:#f8faff;border-color:#c7d2fe;margin:16px 0;">' +
              '<div class="muted small">Verification code</div>' +
              '<div style="font-size:26px;font-weight:800;letter-spacing:2px;font-family:monospace;margin:8px 0;">' +
                TED.esc(res.code) + '</div>' +
              '<button class="btn ghost sm" data-copy-code>Copy code</button></div>' +
            '<p class="small">Once you have posted the code on your profile, click Confirm below.</p>' +
            '<div class="modal-actions">' +
              '<button type="button" class="btn ghost" data-cancel>Cancel</button>' +
              '<button type="button" class="btn" id="confirmVerifyBtn">I&rsquo;ve posted it — Verify</button>' +
            '</div></div></div>';
          modalRoot.querySelector('[data-close]').onclick = function (e) { if (e.target === e.currentTarget) modalRoot.innerHTML = ''; };
          modalRoot.querySelector('[data-cancel]').onclick = function () { modalRoot.innerHTML = ''; };
          modalRoot.querySelector('[data-copy-code]').onclick = function () {
            navigator.clipboard.writeText(res.code).then(function () { TED.toast('Code copied', 'success'); });
          };
          modalRoot.querySelector('#confirmVerifyBtn').onclick = function () {
            this.disabled = true;
            TED.post('/api/stores/' + state.store.id + '/social/' + accountId + '/verify/confirm')
              .then(function () {
                modalRoot.innerHTML = '';
                TED.toast('Platform verified', 'success');
                loadSocial();
              }).catch(function (err) { TED.toast(err.message, 'error'); });
          };
        }).catch(function (err) { TED.toast(err.message, 'error'); });
    }

    document.getElementById('connectSocialBtn').onclick = openConnectSocialModal;

    document.addEventListener('click', function (e) {
      var verifyBtn = e.target.closest('[data-verify-social]');
      if (verifyBtn) { openVerifyModal(Number(verifyBtn.getAttribute('data-verify-social'))); return; }
      var delBtn = e.target.closest('[data-del-social]');
      if (delBtn) {
        if (!confirm('Disconnect this platform from your store?')) return;
        TED.del('/api/stores/' + state.store.id + '/social/' + delBtn.getAttribute('data-del-social'))
          .then(function () { TED.toast('Disconnected', 'success'); loadSocial(); })
          .catch(function (err) { TED.toast(err.message, 'error'); });
        return;
      }
    });
```

