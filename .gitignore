(function seedAiTools(){
  const insert = db.prepare(`
    INSERT INTO ai_tools (slug, name, description, category, icon, pricing_type, price_cents,
                          subscription_period_days, monthly_limit, sort_order)
    VALUES (@slug, @name, @description, @category, @icon, @pricing_type, @price_cents,
            @subscription_period_days, @monthly_limit, @sort_order)
  `);
  AI_TOOL_SEED.forEach(t => {
    if (db.prepare('SELECT id FROM ai_tools WHERE slug = ?').get(t.slug)) return;
    insert.run({ slug:t.slug, name:t.name, description:t.description, category:t.category, icon:t.icon,
      pricing_type:t.pricing_type, price_cents:t.price_cents,
      subscription_period_days:t.subscription_period_days || 30,
      monthly_limit:t.monthly_limit || null, sort_order:t.sort_order });
  });
})();

const AI_RUNTIME = {
  'product-description': function(i){
    const t = String(i.title || '').trim();
    if (!t) throw Object.assign(new Error('Product title is required'), { status:400 });
    const cat = String(i.category || 'product').trim();
    const attrs = String(i.attributes || '').split(/[,\n]/).map(s => s.trim()).filter(Boolean);
    const attrList = attrs.length ? attrs.join(', ') : 'quality craftsmanship';
    const pick = a => a[Math.floor(Math.random()*a.length)];
    const op = pick([`Introducing the ${t}.`, `Meet the ${t} — a ${cat.toLowerCase()} built to deliver.`, `The ${t} is here.`]);
    const mid = pick([`Every detail is intentional: ${attrList}.`, `Built for people who expect more from their ${cat.toLowerCase()}: ${attrList}.`, `${attrList.charAt(0).toUpperCase()+attrList.slice(1)} — because good design shows.`]);
    const cl = pick([`Order today and see why it's the ${cat.toLowerCase()} people come back to.`, `Add it to your cart — it ships fast.`, `Available now, while stocks last.`]);
    return `${op} ${mid}\n\n${cl}`;
  },
  'seo-meta': function(i){
    const t = String(i.title || '').trim();
    if (!t) throw Object.assign(new Error('Page title is required'), { status:400 });
    const d = String(i.description || '').trim() || `${t} — learn more, compare and buy today.`;
    const titleTag = t.length > 60 ? t.slice(0,57)+'...' : t;
    const metaDesc = d.length > 160 ? d.slice(0,157)+'...' : d;
    const slug = t.toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'');
    const stop = new Set('the a an and or for to of in on with by is are this that it be as at from'.split(' '));
    const words = (t+' '+d).toLowerCase().match(/[a-z]{3,}/g) || [];
    const f = {}; words.forEach(w => { if (!stop.has(w)) f[w] = (f[w]||0)+1; });
    const kw = Object.entries(f).sort((a,b)=>b[1]-a[1]).slice(0,8).map(([w])=>w);
    return `Title tag (${titleTag.length}/60)\n${titleTag}\n\nMeta description (${metaDesc.length}/160)\n${metaDesc}\n\nURL slug\n/${slug}\n\nKeywords\n${kw.join(', ')}`;
  },
  'ad-copy': function(i){
    const p = String(i.product || '').trim();
    if (!p) throw Object.assign(new Error('Product name is required'), { status:400 });
    const a = String(i.audience || 'customers').trim();
    const b = String(i.benefit || 'a better experience').trim();
    return `Variation A\nHeadline: ${p} — built for ${a}.\nBody: ${p} gives ${a} ${b}, without the usual tradeoffs.\nCTA: Shop now\n\nVariation B\nHeadline: ${b.charAt(0).toUpperCase()+b.slice(1)} with ${p}.\nBody: Tired of tools that overpromise? ${p} delivers ${b} from day one.\nCTA: Try it today\n\nVariation C\nHeadline: Finally, ${p} that works.\nBody: ${a} asked. We listened. ${p} is the answer.\nCTA: Get yours`;
  },
  'email-subjects': function(i){
    const t = String(i.topic || '').trim();
    if (!t) throw Object.assign(new Error('Email topic is required'), { status:400 });
    const a = String(i.audience || 'subscribers').trim();
    return [`${t}: what ${a} need to know`,`A quick note on ${t}`,`${t} — this week's update`,`You asked about ${t}. Here's the answer.`,`The one thing ${a} get wrong about ${t}`,`New: ${t} just landed`,`${t} in 3 minutes (or less)`,`Why ${t} matters right now`,`Don't miss: ${t} update`,`${t} — read this before you decide`].join('\n');
  },
  'blog-outline': function(i){
    const t = String(i.topic || '').trim();
    if (!t) throw Object.assign(new Error('Topic is required'), { status:400 });
    const a = String(i.audience || 'readers').trim();
    return `Title: The Complete Guide to ${t} for ${a}\n\n1. Introduction\n   - Why ${t} matters now\n   - Who this guide is for\n\n2. What is ${t}?\n   - Core concepts\n   - Common misconceptions\n\n3. Why ${t} matters to ${a}\n   - Key benefits\n   - Real-world examples\n\n4. Getting started with ${t}\n   - Step-by-step approach\n   - Tools and resources\n\n5. Common mistakes\n   - Pitfall #1\n   - Pitfall #2\n   - Pitfall #3\n\n6. Advanced strategies\n   - Scaling up\n   - Measuring impact\n\n7. Conclusion\n   - Key takeaways\n   - Next steps`;
  },
  'review-responder': function(i){
    const r = String(i.review || '').trim();
    const rating = parseInt(i.rating, 10) || 5;
    const brand = String(i.brand || 'our team').trim();
    if (!r) throw Object.assign(new Error('Review text is required'), { status:400 });
    if (rating >= 4) return `Thank you so much for the kind words! Reviews like yours mean the world to ${brand}. We're thrilled you had a great experience and can't wait to serve you again.`;
    if (rating === 3) return `Thanks for the honest feedback. We hear you — and we're taking notes. ${brand} is always looking for ways to improve, and your review helps us do exactly that. If you'd like to tell us more, please reach out directly.`;
    return `We're sorry your experience didn't meet expectations — that's not the standard we hold ourselves to at ${brand}. We'd like the chance to make it right. Please reach out to our team directly so we can look into this personally. Thank you for the feedback.`;
  },
  'keyword-extractor': function(i){
    const txt = String(i.text || '').trim();
    if (!txt) throw Object.assign(new Error('Text is required'), { status:400 });
    const stop = new Set('the a an and or for to of in on with by is are this that it be as at from was were will would could should have has had do does did but if then so not no yes you your we our they their i me my'.split(' '));
    const words = txt.toLowerCase().match(/[a-z]{4,}/g) || [];
    const f = {}; words.forEach(w => { if (!stop.has(w)) f[w] = (f[w]||0)+1; });
    const top = Object.entries(f).sort((a,b)=>b[1]-a[1]).slice(0,15);
    if (!top.length) return 'No meaningful keywords found.';
    return top.map(([w,n]) => `${w} (${n})`).join('\n');
  },
  'tone-rewriter': function(i){
    let txt = String(i.text || '').trim();
    const tone = String(i.tone || 'professional').toLowerCase();
    if (!txt) throw Object.assign(new Error('Text is required'), { status:400 });
    if (tone === 'professional') {
      txt = txt.replace(/!/g,'.').replace(/\bhey\b/gi,'Hello').replace(/\bcan't\b/gi,'cannot')
        .replace(/\bdon't\b/gi,'do not').replace(/\bwon't\b/gi,'will not')
        .replace(/\bit's\b/gi,'it is').replace(/\bwe're\b/gi,'we are').replace(/\bI'm\b/gi,'I am');
    } else if (tone === 'casual') {
      txt = txt.replace(/\bdo not\b/gi,"don't").replace(/\bcannot\b/gi,"can't")
        .replace(/\bwill not\b/gi,"won't").replace(/\bit is\b/gi,"it's")
        .replace(/\bwe are\b/gi,"we're").replace(/\bI am\b/gi,"I'm");
    } else if (tone === 'friendly') {
      txt = txt.replace(/\bhello\b/gi,'Hey there').replace(/\bgoodbye\b/gi,'Take care').replace(/\.\s/g,'! ');
    }
    return txt;
  },
};

/* ======================= DROPSHIP APP DEFINITION ====================== */

const DROPSHIP_APP = {
  slug: 'dropshipping',
  name: 'Dropshipping',
  description: 'Source products from verified suppliers and fulfill orders without holding inventory.',
  trial_days: 14,
  price_cents: 2900,
  period_days: 30,
};

function getDropshipAccess(storeId) {
  const inst = db.prepare('SELECT * FROM app_installs WHERE store_id = ? AND app_slug = ?')
    .get(storeId, DROPSHIP_APP.slug);
  if (!inst) return { installed: false, allowed: false, status: 'not_installed' };
  const now = Date.now();
  const future = s => s ? new Date(s.replace(' ', 'T') + 'Z').getTime() > now : false;
  const daysLeft = s => s ? Math.max(0, Math.ceil((new Date(s.replace(' ', 'T') + 'Z').getTime() - now) / 86400000)) : 0;
  if (inst.status === 'active' && (!inst.expires_at || future(inst.expires_at))) {
    return { installed:true, allowed:true, status:'active', expires_at: inst.expires_at, days_left: daysLeft(inst.expires_at) };
  }
  if (inst.status === 'trial' && future(inst.trial_ends_at)) {
    return { installed:true, allowed:true, status:'trial', trial_ends_at: inst.trial_ends_at, days_left: daysLeft(inst.trial_ends_at) };
  }
  if (inst.status === 'trial') return { installed:true, allowed:false, status:'trial_expired', trial_ends_at: inst.trial_ends_at };
  if (inst.status === 'active') return { installed:true, allowed:false, status:'expired', expires_at: inst.expires_at };
  return { installed:true, allowed:false, status: inst.status };
}

/* ============================ AUTH HELPERS ============================ */

function readToken(req) {
  if (req.cookies && req.cookies[COOKIE_NAME]) return req.cookies[COOKIE_NAME];
  const h = req.headers.authorization || '';
  if (h.startsWith('Bearer ')) return h.slice(7);
  return null;
}
function attachUser(req, _res, next) {
  req.user = null;
  const token = readToken(req);
  if (token) {
    try {
      const payload = jwt.verify(token, SECRET);
      req.user = db.prepare('SELECT id, email, name, role FROM users WHERE id = ?').get(payload.uid) || null;
    } catch (e) {}
  }
  next();
}
function requireAuth(req, res, next) {
  if (!req.user) return res.status(401).json({ error: 'Authentication required' });
  next();
}
function requireSuperadmin(req, res, next) {
  if (!req.user || req.user.role !== 'superadmin') return res.status(403).json({ error: 'Superadmin access required' });
  next();
}
function canManage(user, store) {
  return !!user && !!store && (store.owner_id === user.id || user.role === 'superadmin');
}
function requireStoreOwner(paramName) {
  returnBelow is a surgical patch that adds a full Social Media Integration feature to your existing server.js — no need to regenerate the whole file. Store owners connect their Facebook, Instagram, X, TikTok, Pinterest, YouTube, LinkedIn, WhatsApp, Threads, and Telegram accounts to their store; every connection is verified with a code flow and shown on the public storefront.

There are 5 insertion points. Each block is labelled with exactly where it goes.

