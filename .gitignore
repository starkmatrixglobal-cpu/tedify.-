2. Platform registry + routes — paste after the suppliers block

Find /* ============================== APPS ================================== */ and paste this directly above it:

```js
/* ============================ SOCIAL MEDIA ============================ */

const SOCIAL_PLATFORMS = {
  facebook:  { label: 'Facebook',  icon: 'f',  color: '#1877f2', url: h => 'https://facebook.com/' + h },
  instagram: { label: 'Instagram', icon: '◉',  color: '#e1306c', url: h => 'https://instagram.com/' + h },
  x:         { label: 'X',         icon: '𝕏',  color: '#000000', url: h => 'https://x.com/' + h },
  tiktok:    { label: 'TikTok',    icon: '♪',  color: '#000000', url: h => 'https://tiktok.com/@' + h },
  pinterest: { label: 'Pinterest', icon: 'P',  color: '#e60023', url: h => 'https://pinterest.com/' + h },
  youtube:   { label: 'YouTube',   icon: '▶',  color: '#ff0000', url: h => 'https://youtube.com/@' + h },
  linkedin:  { label: 'LinkedIn',  icon: 'in', color: '#0a66c2', url: h => 'https://linkedin.com/company/' + h },
  whatsapp:  { label: 'WhatsApp',  icon: '✆',  color: '#25d366', url: h => 'https://wa.me/' + h },
  threads:   { label: 'Threads',   icon: '@',  color: '#000000', url: h => 'https://threads.net/@' + h },
  telegram:  { label: 'Telegram',  icon: '✈',  color: '#0088cc', url: h => 'https://t.me/' + h },
};

/* Public: list supported platforms */
app.get('/api/social/platforms', function (_req, res) {
  res.json({ platforms: SOCIAL_PLATFORMS });
});

/* Owner: list connected accounts for a store */
app.get('/api/stores/:storeId/social', requireAuth, requireStoreOwner('storeId'), function (req, res) {
  const accounts = db.prepare(
    'SELECT * FROM social_accounts WHERE store_id = ? ORDER BY connected_at DESC'
  ).all(req.store.id);
  res.json({ accounts: accounts });
});

/* Owner: connect a new platform */
app.post('/api/stores/:storeId/social', requireAuth, requireStoreOwner('storeId'), function (req, res) {
  const b = req.body || {};
  const platform = String(b.platform || '').trim();
  if (!platform || !SOCIAL_PLATFORMS[platform]) {
    return res.status(400).json({ error: 'Unknown platform. Supported: ' + Object.keys(SOCIAL_PLATFORMS).join(', ') });
  }
  const handle = String(b.handle || '').trim().replace(/^@/, '').slice(0, 60);
  if (!handle) return res.status(400).json({ error: 'Handle is required' });
  if (!/^[A-Za-z0-9._-]+$/.test(handle)) {
    return res.status(400).json({ error: 'Handle may only contain letters, numbers, dots, dashes and underscores' });
  }
  const exists = db.prepare('SELECT id FROM social_accounts WHERE store_id = ? AND platform = ?')
    .get(req.store.id, platform);
  if (exists) return res.status(409).json({ error: SOCIAL_PLATFORMS[platform].label + ' is already connected' });

  const url = String(b.profile_url || '').trim().slice(0, 500) || SOCIAL_PLATFORMS[platform].url(handle);
  const info = db.prepare(
    'INSERT INTO social_accounts (store_id, platform, handle, profile_url) VALUES (?, ?, ?, ?)'
  ).run(req.store.id, platform, handle, url);
  res.status(201).json({
    account: db.prepare('SELECT * FROM social_accounts WHERE id = ?').get(info.lastInsertRowid)
  });
});

/* Owner: update handle / url */
app.patch('/api/stores/:storeId/social/:id', requireAuth, requireStoreOwner('storeId'), function (req, res) {
  const row = db.prepare('SELECT * FROM social_accounts WHERE id = ? AND store_id = ?')
    .get(Number(req.params.id), req.store.id);
  if (!row) return res.status(404).json({ error: 'Account not found' });
  const b = req.body || {};
  const f = {};
  if (b.handle !== undefined) {
    const h = String(b.handle).trim().replace(/^@/, '').slice(0, 60);
    if (!h) return res.status(400).json({ error: 'Handle cannot be empty' });
    if (!/^[A-Za-z0-9._-]+$/.test(h)) return res.status(400).json({ error: 'Invalid handle' });
    f.handle = h;
  }
  if (b.profile_url !== undefined) f.profile_url = String(b.profile_url).slice(0, 500);
  if (b.verified !== undefined) f.verified = b.verified ? 1 : 0;
  const keys = Object.keys(f);
  if (keys.length) {
    db.prepare('UPDATE social_accounts SET ' + keys.map(k => k + ' = ?').join(', ') + ' WHERE id = ?')
      .run.apply(null, keys.map(k => f[k]).concat([row.id]));
  }
  res.json({ account: db.prepare('SELECT * FROM social_accounts WHERE id = ?').get(row.id) });
});

/* Owner: disconnect */
app.delete('/api/stores/:storeId/social/:id', requireAuth, requireStoreOwner('storeId'), function (req, res) {
  const row = db.prepare('SELECT * FROM social_accounts WHERE id = ? AND store_id = ?')
    .get(Number(req.params.id), req.store.id);
  if (!row) return res.status(404).json({ error: 'Account not found' });
  db.prepare('DELETE FROM social_accounts WHERE id = ?').run(row.id);
  res.json({ ok: true });
});

/* Owner: step 1 — request a verification code */
app.post('/api/stores/:storeId/social/:id/verify/request', requireAuth, requireStoreOwner('storeId'), function (req, res) {
  const row = db.prepare('SELECT * FROM social_accounts WHERE id = ? AND store_id = ?')
    .get(Number(req.params.id), req.store.id);
  if (!row) return res.status(404).json({ error: 'Account not found' });
  const code = 'TED-' + crypto.randomBytes(3).toString('hex').toUpperCase();
  db.prepare('UPDATE social_accounts SET verify_code = ? WHERE id = ?').run(code, row.id);
  res.json({
    code: code,
    platform: SOCIAL_PLATFORMS[row.platform].label,
    profile_url: row.profile_url,
    instructions: 'Post this code publicly on your ' + SOCIAL_PLATFORMS[row.platform].label +
      ' profile — in your bio, a pinned post, or a story. Then come back and click "I\'ve posted it".'
  });
});

/* Owner: step 2 — confirm the code was posted */
app.post('/api/stores/:storeId/social/:id/verify/confirm', requireAuth, requireStoreOwner('storeId'), function (req, res) {
  const row = db.prepare('SELECT * FROM social_accounts WHERE id = ? AND store_id = ?')
    .get(Number(req.params.id), req.store.id);
  if (!row) return res.status(404).json({ error: 'Account not found' });
  if (!row.verify_code) return res.status(400).json({ error: 'Request a verification code first' });
  /* In production: fetch the public profile and confirm verify_code appears in the bio/post.
     In this build: the owner self-attests after posting the code. */
  db.prepare('UPDATE social_accounts SET verified = 1, verify_code = NULL WHERE id = ?').run(row.id);
  res.json({ account: db.prepare('SELECT * FROM social_accounts WHERE id = ?').get(row.id) });
});

/* PUBLIC: storefront reads social links by slug */
app.get('/api/stores/:slug/social', function (req, res) {
  const store = db.prepare('SELECT * FROM stores WHERE slug = ?').get(req.params.slug);
  if (!store) return res.status(404).json({ error: 'Store not found' });
  const rows = db.prepare(
    'SELECT platform, handle, profile_url, verified FROM social_accounts WHERE store_id = ? ORDER BY verified DESC, connected_at ASC'
  ).all(store.id);
  res.json({
    social: rows.map(r => Object.assign({}, r, {
      label: (SOCIAL_PLATFORMS[r.platform] || {}).label || r.platform,
      icon:  (SOCIAL_PLATFORMS[r.platform] || {}).icon  || '?',
      color: (SOCIAL_PLATFORMS[r.platform] || {}).color || '#666'
    }))
  });
});
```

